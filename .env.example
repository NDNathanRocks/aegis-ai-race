# Copy to .env. Everything is optional: with no values the app boots in zero-key demo mode.

# Live LLM output (https://console.groq.com). Without it the LLM text is simulated.
GROQ_API_KEY=

# Semantic cache backend. Empty = in-memory NumPy fallback.
#   docker compose --profile redis up   ->   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Vector store. Empty = zero-config local NumPy index.
#   docker compose --profile pgvector up ->  DATABASE_URL=postgresql://aegis:aegis@pgvector:5432/aegis
DATABASE_URL=

# Comma-separated browser origins allowed to call the API (your frontend / portfolio origins).
CORS_ORIGINS=http://localhost:3000

# Backend URL as seen by the visitor's browser (baked into the frontend at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Requests per minute per client IP on the race endpoints.
RATE_LIMIT_PER_MIN=30

# ONNX/BLAS threads. 1 is right under a CPU quota (set in the Dockerfile; also forced in-process before onnxruntime loads).
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1

# Behind a reverse proxy (Render, HF Spaces): honour X-Forwarded-For for per-client rate limits.
# Leave unset when exposed directly, otherwise clients can spoof the header.
# TRUST_PROXY=1
# TRUSTED_PROXY_HOPS=1

# Model ids are account-dependent on Groq. If /api/config shows mode "live" but races fall back with
# fallback_reason=upstream_error, the key may lack access to the defaults (404 model_not_found).
# List what your key can use: curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_HEAVY_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
